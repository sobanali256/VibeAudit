# Control plane (VM 1) only. Never copied into a sandbox.
DATABASE_URL=postgres://vibeaudit:vibeaudit@127.0.0.1:5432/vibeaudit

# Vultr Serverless Inference (OpenAI-compatible)
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
PLANNER_MODEL=
VISION_MODEL=

# Sandbox host (VM 2), reached via `docker context` over SSH on the VPC
SANDBOX_DOCKER_HOST=ssh://root@10.10.0.3
# Egress proxy on VM 1 as seen from sandbox containers
SANDBOX_PROXY_URL=http://10.10.0.2:8080

# Optional: GitHub token for higher rate limits on public tarball downloads (read-only)
GITHUB_TOKEN=
